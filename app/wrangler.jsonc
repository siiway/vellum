{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "vellum",
	"main": "src/worker/index.ts",
	"compatibility_date": "2025-02-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Browser-only packages that SSR reaches through client components but
	// never runs. Swapping them for a stub keeps several megabytes out of the
	// Worker bundle, which every cold start has to load.
	"alias": {
		"mermaid": "./src/worker/browser-only.ts",
		"vue": "./src/worker/browser-only.ts",
		"vue3-sfc-loader": "./src/worker/browser-only.ts"
	},
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// "VELLUM_GITHUB_TOKEN": "",
		// "VELLUM_WEBHOOK_SECRET": "",
		"VELLUM_CACHE_TTL_SECONDS": "300",
		"VELLUM_HTML_TTL_SECONDS": "60",
		"VELLUM_STALE_TTL_SECONDS": "86400"
	},
	"routes": [
		{
			"pattern": "docs.siiway.org",
			"custom_domain": true
		},
		{
			"pattern": "vellum.siiway.org",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "VELLUM_CACHE",
			"id": "8999733736ff415c844f1c8fc00c3042"
		}
	],
	// Preview environment: deploys to vellum.siiway.workers.dev.
	// Deploy with: wrangler deploy --env preview
	"env": {
		"preview": {
			"workers_dev": true,
			"routes": []
		}
	}
}