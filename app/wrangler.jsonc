{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "vellum",
	"compatibility_date": "2025-02-01",
	// A static site: no Worker code, only the pre-rendered output of
	// `bun run build`. `_redirects` and `_headers` in it are applied by
	// Cloudflare.
	"assets": {
		"directory": "./dist/site",
		// Pages are written as {page}/index.html and served at {page}.
		"html_handling": "drop-trailing-slash",
		// The nearest 404.html up the path: localized per locale prefix.
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "docs.siiway.org",
			"custom_domain": true
		},
		{
			"pattern": "vellum.siiway.org",
			"custom_domain": true
		}
	],
	// Preview environment: deploys to vellum-preview.siiway.workers.dev.
	// Deploy with: wrangler deploy --env preview
	"env": {
		"preview": {
			"workers_dev": true,
			"routes": []
		}
	}
}
